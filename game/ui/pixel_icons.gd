static func get_icon(icon_name: String) -> Texture2D:
	if _cache.has(icon_name):
		return _cache[icon_name]
	var rows: Array = ICONS.get(icon_name, ICONS["info"])
	var img := Image.create(9, 9, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in range(mini(9, rows.size())):
		var row: String = rows[y]
		for x in range(mini(9, row.length())):
			var ch := row[x]
			if PALETTE.has(ch):
				img.set_pixel(x, y, PALETTE[ch])
			elif ch != ".":
				img.set_pixel(x, y, PALETTE["o"]) # tolerate stray glyphs
	var tex := ImageTexture.create_from_image(img)
	_cache[icon_name] = tex
	return tex


## Draws an icon centered at `center` with integer scale (1 = 9px in the 480x270 canvas).
static func draw_icon(canvas: CanvasItem, icon_name: String, center: Vector2, scale: int = 1, modulate: Color = Color.WHITE) -> void:
	var s := 9 * scale
	canvas.draw_texture_rect(get_icon(icon_name), Rect2(center - Vector2(s, s) * 0.5, Vector2(s, s)).abs(), false, modulate)
